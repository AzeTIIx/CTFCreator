# CTFd runtime env — EXEMPLE FICTIF. Copier vers config/ctfd.env (gitignore).
# Permissions cibles : 0600. Ne jamais logger ces valeurs.

SECRET_KEY=replace-me-with-generated-secret
DATABASE_URL=mysql+pymysql://ctfd:replace-me-db-password@db:3306/ctfd
REDIS_URL=redis://:replace-me-redis-password@cache:6379
UPLOAD_FOLDER=/var/uploads
WORKERS=2
LOG_FOLDER=/var/log/CTFd
ACCESS_LOG=-
ERROR_LOG=-
REVERSE_PROXY=true
# Préconfiguration admin fictive (CTFd >= 3.8) — valeurs d'exemple uniquement
# PRESET_ADMIN_NAME=admin_cours
# PRESET_ADMIN_EMAIL=admin@cours.example.invalid
# PRESET_ADMIN_PASSWORD=replace-me
# PRESET_ADMIN_TOKEN=replace-me-token
