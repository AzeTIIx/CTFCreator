# =============================================================================
# course-ctfd-infra — variables d'environnement (EXEMPLE FICTIF UNIQUEMENT)
# Copier vers .env à la racine du dépôt, puis renseigner les valeurs réelles.
# Ne jamais committer .env. Permissions cibles : 0600.
# =============================================================================

# --- Système cible (obligatoire pour deploy / harden / firewall) ---
# Distribution supportée : Debian 12 (bookworm) — voir README.md
TARGET_DISTRO=debian
TARGET_DISTRO_VERSION=12
VPS_PROVIDER=OVH
# Hôte Linux dédié CTFd uniquement (pas d'autres services importants)
TARGET_HOST=ctfd.cours.example.invalid
ADMIN_SSH_USER=coursadmin
# Clé publique OpenSSH à installer avant durcissement (ou passer --pubkey / --pubkey-file)
# ADMIN_SSH_PUBKEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeExampleKeyMaterialOnlyNotReal admin@laptop
# ADMIN_SSH_PUBKEY_FILE=/home/coursadmin/.ssh/id_ed25519.pub
# Identity privée UNIQUEMENT pour test de reconnexion depuis l'hôte (ne jamais committer)
# ADMIN_SSH_IDENTITY_FILE=
# Port SSH actuel / cible (ne change pas sans valeur explicite)
# SSH est ouvert depuis any (admin mobile) — compensation : clés uniquement via harden-ssh
SSH_PORT=22
# Compte autorisé pour AllowUsers (obligatoire si ALLOW_USERS_ENABLED=true)
ALLOW_USERS_ENABLED=false
ALLOW_USERS=coursadmin
# Second accès admin disponible (console fournisseur, second opérateur, etc.)
SECOND_ADMIN_ACCESS_CONFIRMED=false

# --- DNS / TLS ---
CTFD_FQDN=ctfd.cours.example.invalid
# true uniquement si un reverse proxy TLS est déjà en place ou sera configuré
TLS_ENABLED=false
# Chemin local vers certificats (non versionnés) — laisser vide si Let's Encrypt géré hors dépôt
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- Déploiement CTFd ---
# Mode : degraded | containers (plugin challenge_containers / 0xfbad)
DEPLOY_MODE=containers
COMPOSE_PROJECT_NAME=ctfd
CTFD_IMAGE=ctfd/ctfd:3.8.6
CTFD_COURSE_IMAGE=course-ctfd:3.8.6-containers
MARIADB_IMAGE=mariadb:10.11.13
REDIS_IMAGE=redis:7.2.16-bookworm
NGINX_IMAGE=nginx:1.28.3
ALPINE_IMAGE=alpine:3.21.3
# Ne jamais utiliser latest. Les digests doivent être vérifiés sur la cible :
# docker pull <image> && docker image inspect <image> --format '{{index .RepoDigests 0}}'

# GID du groupe docker sur l'hôte (OBLIGATOIRE) :
#   getent group docker | cut -d: -f3
DOCKER_GID=999
# Répertoire SSH hôte copié dans le volume ctfd_ssh (contexts distants)
# Dossier VIDE sauf si le plugin pilote un Docker host distant (copié dans le conteneur CTFd)
HOST_SSH_DIR=/opt/ctfd-empty-ssh

# Chemins locaux sur le VPS
INSTALL_ROOT=/opt/CTFCreator/platform
BACKUP_ROOT=/var/backups/course-ctfd
DATA_ROOT=/var/lib/course-ctfd

# Ressources CTFd
CTFD_WORKERS=2
CTFD_MEMORY_LIMIT=1g
CTFD_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1g
CACHE_MEMORY_LIMIT=256m
NGINX_MEMORY_LIMIT=128m

# Secrets : générés une seule fois par scripts/deploy.py si absents.
# Ne jamais les imprimer. Ne pas les remplacer silencieusement.
# SECRET_KEY=  (laisser vide pour génération à l'installation)
# DB_ROOT_PASSWORD=
# DB_PASSWORD=
# REDIS_PASSWORD=

# --- Registre privé ---
REGISTRY_ENABLED=false
REGISTRY_IMAGE=registry:2.8.3
REGISTRY_BIND=127.0.0.1:5000
# Authentification htpasswd hors dépôt si REGISTRY_AUTH_REQUIRED=true
REGISTRY_AUTH_REQUIRED=true

# --- Docker ---
# true uniquement si l'opérateur demande explicitement l'installation Docker
INSTALL_DOCKER_IF_MISSING=false
# Plugin d'instances : challenge_containers (0xfbad, accepté) | none
# Jamais TheOriginalOrangeJuice (refusé). Voir docs/plugin-compatibility.md
PLUGIN_SELECTION=challenge_containers

# --- Pare-feu ---
# nftables | ufw | auto (détecte après inventaire, n'installe pas les deux)
FIREWALL_BACKEND=auto
HTTP_PUBLIC=true
HTTPS_PUBLIC=true
# Ports challenge publiés uniquement via mécanisme plugin+proxy (vide en mode degraded)
CHALLENGE_PORT_RANGE=

# --- Vérifications ---
# URL de santé CTFd derrière le proxy (chemin relatif)
CTFD_HEALTH_PATH=/
CTFD_HEALTH_TIMEOUT_SEC=30

# --- Dry-run global (peut aussi être passé en CLI) ---
DRY_RUN=false
